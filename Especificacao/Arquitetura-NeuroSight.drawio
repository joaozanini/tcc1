  <diagram id="fluxo" name="Figura – Fluxo de uma sessão">
    <mxGraphModel dx="830" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="830" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="fluxo-web" value="&lt;b&gt;Sistema web&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;usado pelo pesquisador&lt;/i&gt;&lt;/font&gt;&lt;br&gt;Cadastra pacientes e estímulos&lt;br&gt;Monta sessões por modelo ou na hora&lt;br&gt;Define o tempo de cada estímulo&lt;br&gt;Envia a sessão a um óculos e a inicia&lt;br&gt;Mostra os dados para análise" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="40" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="fluxo-srv" value="&lt;b&gt;Servidor&lt;/b&gt;&lt;br&gt;Guarda as sessões configuradas&lt;br&gt;Entrega a sessão e o comando de início&lt;br&gt;Recebe o JSON e os quadros&lt;br&gt;Monta o vídeo e associa tudo à sessão e ao paciente" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="280" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="fluxo-quest" value="&lt;b&gt;Meta Quest Pro&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;usado pelo paciente&lt;/i&gt;&lt;/font&gt;&lt;br&gt;Baixa a sessão e os estímulos&lt;br&gt;Exibe cada estímulo no tempo definido&lt;br&gt;Coleta olhar e expressões faciais&lt;br&gt;Grava a cena&lt;br&gt;Envia o JSON e os quadros ao fim da sessão" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="500" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="fluxo-nota" value="Antes do primeiro uso, o óculos é pareado ao tenant por um código (SD02)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#808080;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="600" y="530" width="200" height="66" as="geometry"/></mxCell>
        <mxCell id="fluxo-e1" value="sessão configurada&lt;br&gt;e comando de início" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;fontSize=11;fontColor=#333333;align=right;spacingRight=8;labelBackgroundColor=none;exitX=0.2188;exitY=1;exitDx=0;exitDy=0;entryX=0.2188;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-web" target="fluxo-srv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fluxo-e2" value="estado da sessão e&lt;br&gt;dados para análise" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;fontSize=11;fontColor=#333333;align=left;spacingLeft=8;labelBackgroundColor=none;exitX=0.7813;exitY=0;exitDx=0;exitDy=0;entryX=0.7813;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-srv" target="fluxo-web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fluxo-e3" value="sessão, estímulos e&lt;br&gt;comando de início&lt;br&gt;(consulta a cada ~1 s)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;fontSize=11;fontColor=#333333;align=right;spacingRight=8;labelBackgroundColor=none;exitX=0.2188;exitY=1;exitDx=0;exitDy=0;entryX=0.2188;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxo-srv" target="fluxo-quest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>

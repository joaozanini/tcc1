  <diagram id="fluxo" name="Figura – Fluxo de uma sessão">
    <mxGraphModel dx="900" dy="120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="fluxo-p1" value="&lt;b&gt;1. Sistema web&lt;/b&gt;&lt;br&gt;o pesquisador envia a sessão a um óculos pareado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="131" height="96" as="geometry"/></mxCell>
        <mxCell id="fluxo-p2" value="&lt;b&gt;2. App de coleta&lt;/b&gt;&lt;br&gt;baixa a sessão e os estímulos e avisa que está pronto" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="159" y="10" width="131" height="96" as="geometry"/></mxCell>
        <mxCell id="fluxo-p3" value="&lt;b&gt;3. Sistema web&lt;/b&gt;&lt;br&gt;libera o botão “Iniciar”; o óculos começa em até ~2 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="308" y="10" width="131" height="96" as="geometry"/></mxCell>
        <mxCell id="fluxo-p4" value="&lt;b&gt;4. App de coleta&lt;/b&gt;&lt;br&gt;exibe os estímulos e grava olhar, expressões e cena, mesmo sem rede" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="457" y="10" width="131" height="96" as="geometry"/></mxCell>
        <mxCell id="fluxo-p5" value="&lt;b&gt;5. App de coleta&lt;/b&gt;&lt;br&gt;ao fim, envia o JSON e os quadros, em lotes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="606" y="10" width="131" height="96" as="geometry"/></mxCell>
        <mxCell id="fluxo-p6" value="&lt;b&gt;6. Processamento&lt;/b&gt;&lt;br&gt;importa as amostras para o banco e monta o vídeo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="755" y="10" width="131" height="96" as="geometry"/></mxCell>

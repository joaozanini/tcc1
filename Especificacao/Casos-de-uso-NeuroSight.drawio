        <mxCell id="UC00-n1" value="Perfis cumulativos (RN05): cada perfil herda os casos de uso do perfil para onde a seta aponta. Usuário é abstrato: qualquer pessoa com conta." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#808080;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="185" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="UC00-n2" value="Pessoa sem conta: conhece o sistema e cria um tenant (UC01)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#808080;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="150" y="262" width="220" height="56" as="geometry"/></mxCell>
        <mxCell id="UC00-n3" value="Não é usuário (RN06). Ator secundário: usa o óculos durante a execução da sessão (UC08.3)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#808080;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="490" y="262" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="UC00-n4" value="O app do óculos faz parte do NeuroSight; por isso não aparece como ator." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#808080;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="700" height="34" as="geometry"/></mxCell>
